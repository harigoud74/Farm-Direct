# GEMINI_API_KEY: Optional for live Gemini AI API calls.
# If unset or in mock mode, FarmDirect uses built-in smart agricultural intelligence algorithms.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

